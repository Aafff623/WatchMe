<Window x:Class="WatchMe.Notch.NotchCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True" Focusable="False"
        Width="260" Height="28" IsHitTestVisible="True" AllowDrop="True"
        DragOver="OnDragOver" Drop="OnDrop">
    <Border x:Name="Pill" VerticalAlignment="Top" HorizontalAlignment="Center"
            Width="150" Height="14" CornerRadius="0,0,9,9"
            Background="{DynamicResource Brush.PanelBgSolid}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1,0,1,1"
            SnapsToDevicePixels="True">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="Caption" Text="WatchMe" FontSize="7.5" Foreground="#9E9EA8"
                       FontFamily="Segoe UI" VerticalAlignment="Center" Margin="0,-1,0,0" />
            <Ellipse x:Name="CoffeeDot" Width="5" Height="5" Fill="{DynamicResource Brush.Coffee}"
                     Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
