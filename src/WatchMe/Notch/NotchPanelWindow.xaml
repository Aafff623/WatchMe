<Window x:Class="WatchMe.Notch.NotchPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:notes="clr-namespace:WatchMe.Notes"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        Width="420" Height="600" Focusable="True"
        PreviewKeyDown="OnPanelPreviewKeyDown"
        Deactivated="OnPanelDeactivated"
        MouseLeave="OnPanelMouseLeave" MouseEnter="OnPanelMouseEnter">
    <Grid>
        <Border x:Name="Root" VerticalAlignment="Top" Height="0" ClipToBounds="True"
                Background="{DynamicResource Brush.PanelBg}"
                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1,0,1,1"
                CornerRadius="0,0,18,18" Opacity="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- header: title + settings -->
                <Border Grid.Row="0" Padding="12,8,10,2">
                    <DockPanel>
                        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="⚙"
                                FontSize="13" Click="OnSettingsClick" ToolTip="设置"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource Brush.TextSecondary}" Cursor="Hand" />
                        <Button x:Name="CollapseButton" DockPanel.Dock="Right" Content="▴" Margin="0,0,10,0"
                                FontSize="13" Click="OnCollapseClick" ToolTip="收起 (Esc)"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{DynamicResource Brush.TextSecondary}" Cursor="Hand" />
                        <TextBlock Text="便签" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- sticky board -->
                <notes:StickyBoardView x:Name="Board" Grid.Row="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
