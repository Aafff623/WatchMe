<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.PanelBg">#EE1C1C22</Color>
    <Color x:Key="Color.PanelBgSolid">#1C1C22</Color>
    <Color x:Key="Color.PanelBorder">#3A3A46</Color>
    <Color x:Key="Color.TextPrimary">#F2F2F7</Color>
    <Color x:Key="Color.TextSecondary">#9E9EA8</Color>
    <Color x:Key="Color.Accent">#0A84FF</Color>
    <Color x:Key="Color.AccentSoft">#2C2C3A</Color>
    <Color x:Key="Color.HoverBg">#32323E</Color>
    <Color x:Key="Color.ChipBg">#2A2A34</Color>
    <Color x:Key="Color.ChipBorder">#40404C</Color>
    <Color x:Key="Color.Danger">#FF453A</Color>
    <Color x:Key="Color.Coffee">#FFD60A</Color>
    <Color x:Key="Color.EditorBg">#232329</Color>
    <Color x:Key="Color.SelectionBg">#0A84FF33</Color>

    <SolidColorBrush x:Key="Brush.PanelBg" Color="{StaticResource Color.PanelBg}" />
    <SolidColorBrush x:Key="Brush.PanelBgSolid" Color="{StaticResource Color.PanelBgSolid}" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="{StaticResource Color.PanelBorder}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.HoverBg" Color="{StaticResource Color.HoverBg}" />
    <SolidColorBrush x:Key="Brush.ChipBg" Color="{StaticResource Color.ChipBg}" />
    <SolidColorBrush x:Key="Brush.ChipBorder" Color="{StaticResource Color.ChipBorder}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Coffee" Color="{StaticResource Color.Coffee}" />
    <SolidColorBrush x:Key="Brush.EditorBg" Color="{StaticResource Color.EditorBg}" />
    <SolidColorBrush x:Key="Brush.SelectionBg" Color="{StaticResource Color.SelectionBg}" />
</ResourceDictionary>
