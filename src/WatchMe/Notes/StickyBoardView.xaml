<UserControl x:Class="WatchMe.Notes.StickyBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <!-- quick-add box -->
        <Style x:Key="AddBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.EditorBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- tag filter chip -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.ChipBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniCombo" TargetType="ComboBox">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Background" Value="#22000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="CardText" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Foreground" Value="#2B2B33" />
            <Setter Property="CaretBrush" Value="#2B2B33" />
        </Style>
        <!-- done circle -->
        <Style x:Key="DoneCircle" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="18" Height="18">
                            <Ellipse x:Name="Ring" Stroke="#8A8A7A" StrokeThickness="1.5" Fill="Transparent" />
                            <Ellipse x:Name="Fill" Stroke="#5A9E6F" StrokeThickness="1.5" Fill="#5A9E6F"
                                     Visibility="Collapsed" />
                            <Path x:Name="Tick" Data="M4,9 L8,13 L14,5" Stroke="White" StrokeThickness="2"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- quick add -->
        <Border DockPanel.Dock="Top" Padding="10,10,10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QuickAdd" Style="{StaticResource AddBox}"
                         KeyDown="OnQuickAddKeyDown"
                         ToolTip="记点什么，回车保存" />
                <ComboBox x:Name="NewTagCombo" Grid.Column="2" IsEditable="True" FontSize="11.5"
                          Background="{DynamicResource Brush.EditorBg}"
                          Foreground="{DynamicResource Brush.TextPrimary}"
                          ToolTip="新便签的分类（可直接输入新分类名）" />
            </Grid>
        </Border>

        <!-- tag filter -->
        <Border DockPanel.Dock="Top" Padding="10,0,10,6">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="AllChip" Style="{StaticResource Chip}" Content="全部"
                              IsChecked="True" Click="OnFilterAll" />
                <ItemsControl x:Name="TagChips">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- undo pill row -->
        <Border x:Name="UndoRow" DockPanel.Dock="Top" Padding="10,0,10,4" Visibility="Collapsed">
            <ToggleButton x:Name="UndoButton" Style="{StaticResource Chip}" Content="↩ 撤销删除"
                          HorizontalAlignment="Left" Click="OnUndoDelete" />
        </Border>

        <!-- cards -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,2,10">
            <StackPanel>
                <TextBlock x:Name="EmptyHint" Text="还没有便签，在上面输入第一条吧" FontSize="11.5"
                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="4,18,0,0"
                           Visibility="Collapsed" />
                <ItemsControl x:Name="Cards" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
