<UserControl x:Class="WatchMe.Notes.NotebookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml">
    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.HoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource Brush.PanelBorder}" />
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="RadiusX" Value="0.5" />
            <Setter Property="RadiusY" Value="0.5" />
        </Style>
        <Style x:Key="FindBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Brush.EditorBg}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,4">
            <WrapPanel>
                <Button Style="{StaticResource ToolButton}" Content="B" FontWeight="Bold" Click="OnBold" ToolTip="粗体" />
                <Button Style="{StaticResource ToolButton}" Content="I" FontStyle="Italic" Click="OnItalic" ToolTip="斜体" />
                <Button Style="{StaticResource ToolButton}" Click="OnStrike" ToolTip="删除线">
                    <TextBlock Text="S" TextDecorations="Strikethrough" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Content="&lt;/&gt;" FontFamily="Cascadia Mono,Consolas" Click="OnInlineCode" ToolTip="行内代码" />
                <Button Style="{StaticResource ToolButton}" Content="🔗" Click="OnLink" ToolTip="链接" />
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Content="❝" Click="OnQuote" ToolTip="引用" />
                <Button Style="{StaticResource ToolButton}" Content="•—" Click="OnBulletList" ToolTip="列表" />
                <Button Style="{StaticResource ToolButton}" Content="☑" Click="OnTaskList" ToolTip="任务列表" />
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Button x:Name="EditModeButton" Style="{StaticResource ToolButton}" Content="编辑" Click="OnEditMode" ToolTip="仅编辑" />
                <Button x:Name="SplitModeButton" Style="{StaticResource ToolButton}" Content="分栏" Click="OnSplitMode" ToolTip="编辑 + 预览" />
                <Button x:Name="PreviewModeButton" Style="{StaticResource ToolButton}" Content="预览" Click="OnPreviewMode" ToolTip="仅预览" />
                <Button Style="{StaticResource ToolButton}" Content="🔍" Click="OnToggleFind" ToolTip="查找替换 (Ctrl+F)" />
            </WrapPanel>
        </Border>

        <Border x:Name="FindBar" DockPanel.Dock="Top" Background="{DynamicResource Brush.AccentSoft}"
                Padding="8,5" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="FindInput" Style="{StaticResource FindBox}" Width="170" ToolTip="查找内容" />
                <TextBox x:Name="ReplaceInput" Style="{StaticResource FindBox}" Width="170" Margin="6,0,0,0" ToolTip="替换为" />
                <Button Style="{StaticResource ToolButton}" Content="替换" Click="OnReplaceOne" />
                <Button Style="{StaticResource ToolButton}" Content="全部替换" Click="OnReplaceAll" />
                <Button Style="{StaticResource ToolButton}" Content="✕" Click="OnToggleFind" />
            </StackPanel>
        </Border>

        <Grid x:Name="ContentGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="EditorColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="4" />
                <ColumnDefinition x:Name="PreviewColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <avalonedit:TextEditor x:Name="Editor" Grid.Column="0" Margin="8,2"
                                   Background="{DynamicResource Brush.EditorBg}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                                   FontFamily="Cascadia Mono,Consolas" FontSize="13" WordWrap="True"
                                   Padding="6" PreviewKeyDown="OnEditorPreviewKeyDown" />

            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource Brush.PanelBorder}" />

            <mdxam:MarkdownScrollViewer x:Name="Preview" Grid.Column="2" Margin="8,2"
                                         Background="{DynamicResource Brush.EditorBg}"
                                         BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1"
                                         Padding="10" />
        </Grid>
    </DockPanel>
</UserControl>
