<Window x:Class="WatchMe.Clipboard.ClipboardHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WatchMe · 剪贴板历史" Width="420" Height="520"
        WindowStyle="ToolWindow" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource Brush.PanelBgSolid}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.HoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="8,6" Margin="4,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.HoverBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="{DynamicResource Brush.PanelBorder}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="📋 剪贴板历史" FontWeight="SemiBold" FontSize="13"
                           Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6" />
                <TextBox x:Name="SearchInput" Padding="6,4" FontSize="12" TextChanged="OnSearchChanged"
                         Background="{DynamicResource Brush.EditorBg}"
                         Foreground="{DynamicResource Brush.TextPrimary}"
                         CaretBrush="{DynamicResource Brush.TextPrimary}"
                         BorderBrush="{DynamicResource Brush.PanelBorder}" ToolTip="搜索历史内容" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="10,6" BorderBrush="{DynamicResource Brush.PanelBorder}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" Content="清空历史"
                        Foreground="{DynamicResource Brush.Danger}" Click="OnClearAll" />
                <TextBlock x:Name="CountText" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </DockPanel>
        </Border>

        <ListBox x:Name="EntriesList" ItemContainerStyle="{StaticResource HistoryItem}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource RowButton}" Content="复制" Click="OnCopyBack"
                                    ToolTip="重新复制到剪贴板 (双击条目同效)" />
                            <Button Style="{StaticResource RowButton}" Content="📝" Click="OnInsertToNote"
                                    ToolTip="追加到当前笔记" />
                            <Button Style="{StaticResource RowButton}" Content="✕" Click="OnRemove"
                                    ToolTip="删除该条" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{Binding Image}" Height="24" Stretch="Uniform" Margin="0,0,8,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding Display}" FontSize="12" MaxWidth="220" TextWrapping="Wrap"
                                       MaxHeight="34" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.TextPrimary}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
